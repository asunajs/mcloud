{
  "name": "mcloud-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "mcloud WebUI —— 自研 lite 框架（无虚拟 DOM + 编译期优化）+ TSX + daisyUI",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/gzip-sidecars.mjs",
    "preview": "vite preview",
    "typecheck": "tsmc --noEmit"
  },
  "//": "没有 dependencies：运行时是仓库里的 lite/（编译器 + 运行时），CSS 侧是构建期插件。",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@ts-macro/tsc": "^0.3.7",
    "daisyui": "^5.7.38",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.0"
  }
}
