{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "jsx": "preserve",
    "jsxImportSource": "vue-jsx-vapor",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // 显式写 .ts 扩展名：Vite 的原生配置加载器将来会要求；TS 需要这个开关才不报错
    "allowImportingTsExtensions": true
  },
  "include": ["src", "lite/src", "lite/demo", "lite/bench", "vite.config.ts"]
}
